{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Retouch Pro",
  "version": "1.0.0",
  "identifier": "com.collabssoftware.retouchpro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Retouch Pro — AI Portrait & RAW Studio (by Collabs Software)",
        "width": 1520,
        "height": 940,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#060608"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Collabs Software",
    "copyright": "© 2026 Collabs Software. All rights reserved.",
    "category": "Photography",
    "shortDescription": "Professional AI Portrait & RAW Photo Editing",
    "longDescription": "Retouch Pro by Collabs Software — free, offline AI portrait retouching and RAW photo editing with Lightroom-style sliders. Made by Dave Groennesby.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["English", "Dutch"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "section": "graphics"
      }
    }
  }
}
