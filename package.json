{
  "name": "collabs-retouch-pro",
  "version": "1.0.0",
  "description": "What if Lightcraft's precision sliders married Evoto's AI and had Luminar as a baby? You'd get Collabs Retouch Pro. And it's FREE.",
  "main": "main.js",
  "scripts": {
    "start": "electron . --no-sandbox",
    "build:linux": "electron-packager . 'Collabs Retouch Pro' --platform=linux --arch=x64 --icon=icon.png --out=dist --overwrite --ignore='dist'",
    "build:mac": "electron-packager . 'Collabs Retouch Pro' --platform=darwin --arch=arm64,x64 --icon=icon.icns --out=dist --overwrite --ignore='dist'",
    "build:win": "electron-packager . 'Collabs Retouch Pro' --platform=win32 --arch=x64 --icon=icon.ico --out=dist --overwrite --ignore='dist'",
    "build:all": "npm run build:linux && npm run build:mac && npm run build:win"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Groennesby/Collabs-Retouch-Pro.git"
  },
  "keywords": [
    "retouch",
    "lightcraft",
    "lightroom",
    "evoto",
    "portrait",
    "raw"
  ],
  "author": "Dave Groennesby (Collabs Software)",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-packager": "^17.1.2"
  }
}